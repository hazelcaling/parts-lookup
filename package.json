    "seed:dev": "node --env-file=.env scripts/seed.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "jspdf": "^4.2.0",
    "pg": "^8.23.1",
